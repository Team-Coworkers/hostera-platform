# Local/default environment template for Docker or shell exports
# Copy to .env (or export vars in your runtime) and adjust values.

SPRING_PROFILES_ACTIVE=dev
PORT=8080

DATABASE_URL=localhost
DATABASE_PORT=5432
DATABASE_NAME=hostera
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Required in prod profile
JWT_SECRET=replace-with-a-strong-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://team-coworkers.github.io
